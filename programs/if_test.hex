// IF test image: one word per line, 8 hex digits, word 0 = byte address 0x00.
// Encodings hand-checked against the RV32I field layout (see programs/README.md).
00002083 // 0x00: lw   x1, 0(x0)
00108133 // 0x04: add  x2, x1, x1
00e00193 // 0x08: addi x3, x0, 14
40310233 // 0x0c: sub  x4, x2, x3
00310463 // 0x10: beq  x2, x3, +8
00002023 // 0x14: sw   x0, 0(x0)
00202223 // 0x18: sw   x2, 4(x0)
fe021ee3 // 0x1c: bne  x4, x0, -4
